<robot name="three-revolute-planar">
  <link name="base" /><link name="first" /><link name="second" /><link name="wrist" /><link name="tip" />
  <joint name="shoulder" type="revolute"><parent link="base" /><child link="first" /><axis xyz="0 0 1" /><limit lower="-3.14" upper="3.14" /></joint>
  <joint name="elbow" type="revolute"><parent link="first" /><child link="second" /><origin xyz="0.3 0 0" /><axis xyz="0 0 1" /><limit lower="-3.14" upper="3.14" /></joint>
  <joint name="wrist_rotation" type="revolute"><parent link="second" /><child link="wrist" /><origin xyz="0.3 0 0" /><axis xyz="0 0 1" /><limit lower="-3.14" upper="3.14" /></joint>
  <joint name="tool" type="fixed"><parent link="wrist" /><child link="tip" /><origin xyz="0.04 0 0" /></joint>
</robot>
